# Backend API base URL
# Local (backend running on machine): http://localhost:8080
# Railway:                            https://ai-website-builder-be-production.up.railway.app
# Docker / proxy mode:                (leave empty — Vite proxy handles it)
VITE_API_BASE_URL=http://localhost:8080

# Proxy mode — set to true if you are NOT running the backend locally.
# Vite will forward /api/* requests to the Railway backend during npm run dev.
# Your friend only needs to flip this one variable.
USE_PROXY=false
