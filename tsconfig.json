{
  "files": [],
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "target": "ES2020",
    "module": "ESNext",
    "jsx": "react-jsx",
    "strict": true,
    "moduleResolution": "bundler",
    "baseUrl": "./src",
    "paths": {
      "@/app/*": [
        "app/*"
      ],
      "@/domains/*": [
        "domains/*"
      ],
      "@/shared/*": [
        "shared/*"
      ],
      "@/templates/*": [
        "templates/*"
      ],
      "@/infra/*": [
        "infrastructure/*"
      ],
      "@/store/*": [
        "store/*"
      ]
    }
  },
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.node.json"
    }
  ]
}